{
  "productName": "openpup",
  "version": "0.1.6",
  "identifier": "com.openpup.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico","icons/icon.icns"]
  },
  "app": {
    "windows": [
      {
        "title": "openpup",
        "width": 1100,
        "height": 750,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}

